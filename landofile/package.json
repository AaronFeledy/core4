{
  "name": "@lando/landofile",
  "description": "Private Landofile implementation for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/AaronFeledy/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFeledy/core4.git",
    "directory": "landofile"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./compiled-sites": "./src/compiled-sites.ts",
    "./compiled-loader": "./src/compiled-loader.ts",
    ".": "./src/index.ts",
    "./app-resolution": "./src/app-resolution.ts",
    "./app-root-provenance": "./src/app-root-provenance.ts",
    "./author-modules": "./src/author-modules.ts",
    "./bun-sh-discovery": "./src/bun-sh-discovery.ts",
    "./bun-sh-metadata": "./src/bun-sh-metadata.ts",
    "./bun-sh-script": "./src/bun-sh-script.ts",
    "./compose/rejection-trie": "./src/compose/rejection-trie.ts",
    "./compose/rejections": "./src/compose/rejections.ts",
    "./config-translate": "./src/config-translate.ts",
    "./pipeline/materialize": "./src/pipeline/materialize.ts",
    "./pipeline/source-table": "./src/pipeline/source-table.ts",
    "./include-layer-overlays": "./src/include-layer-overlays.ts",
    "./copy-provenance": "./src/copy-provenance.ts",
    "./decode": "./src/decode.ts",
    "./discovery": "./src/discovery.ts",
    "./traversal-policy": "./src/traversal-policy.ts",
    "./operation-discovery": "./src/operation-discovery.ts",
    "./operation-scope": "./src/operation-scope.ts",
    "./env-file": "./src/env-file.ts",
    "./git-ref": "./src/git-ref.ts",
    "./include-guard": "./src/include-guard.ts",
    "./include-provenance": "./src/include-provenance.ts",
    "./includes": "./src/includes.ts",
    "./layers": "./src/layers.ts",
    "./lint": "./src/lint.ts",
    "./load-expression": "./src/load-expression.ts",
    "./load-expression-decoders": "./src/load-expression-decoders.ts",
    "./load-expression-file": "./src/load-expression-file.ts",
    "./load-expression-provenance": "./src/load-expression-provenance.ts",
    "./merge": "./src/merge.ts",
    "./npm-integrity": "./src/npm-integrity.ts",
    "./parser": "./src/parser.ts",
    "./ports": "./src/ports.ts",
    "./recipe-expressions": "./src/recipe-expressions.ts",
    "./route-filters": "./src/route-filters.ts",
    "./route-normalize": "./src/route-normalize.ts",
    "./root-compile": "./src/root-compile.ts",
    "./source": "./src/source.ts",
    "./schema": "./src/schema.ts",
    "./secret-reference": "./src/secret-reference.ts",
    "./serializer": "./src/serializer.ts",
    "./service": "./src/service.ts",
    "./template-render": "./src/template-render.ts",
    "./tooling-unsupported": "./src/tooling-unsupported.ts",
    "./tooling-defaults": "./src/tooling-defaults.ts",
    "./tooling-normalize": "./src/tooling-normalize.ts",
    "./tooling-input": "./src/tooling-input.ts",
    "./tooling-input-normalize": "./src/tooling-input-normalize.ts",
    "./tooling-input-redaction": "./src/tooling-input-redaction.ts",
    "./tooling-fragment": "./src/tooling-fragment.ts",
    "./tooling-include-entries": "./src/tooling-include-entries.ts",
    "./tooling-include-provenance": "./src/tooling-include-provenance.ts",
    "./tooling-includes": "./src/tooling-includes.ts",
    "./ts-loader": "./src/ts-loader.ts",
    "./version-constraint": "./src/version-constraint.ts",
    "./validation": "./src/validation.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "landofile"],
  "dependencies": {
    "@lando/paths": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*",
    "effect": "catalog:",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
