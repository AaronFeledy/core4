{
  "name": "@lando/landofile",
  "description": "Private Landofile implementation for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "landofile"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "landofile"],
  "dependencies": {
    "@lando/paths": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
