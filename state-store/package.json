{
  "name": "@lando/state-store",
  "description": "Private durable state implementation for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "state-store"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./atomic": "./src/atomic.ts",
    "./codec": "./src/codec.ts",
    "./lock": "./src/lock.ts",
    "./paths": "./src/paths.ts",
    "./service": "./src/service.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "state-store"],
  "dependencies": {
    "@lando/paths": "workspace:*",
    "@lando/sdk": "workspace:*",
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b"
  }
}
