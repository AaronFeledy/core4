{
  "name": "@lando/paths",
  "description": "Private Effect-free Lando root and derived-path resolution primitive.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "paths"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./src/paths.ts",
  "types": "./src/paths.ts",
  "exports": {
    ".": "./src/paths.ts",
    "./overlay": "./src/overlay.ts",
    "./yaml-min": "./src/yaml-min.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "paths"],
  "dependencies": {
    "@lando/sdk": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
