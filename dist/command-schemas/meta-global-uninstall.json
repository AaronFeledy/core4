{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "string"
    },
    "dist": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "serviceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "created",
            "updated",
            "unchanged"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "status",
        "serviceIds"
      ],
      "type": "object"
    },
    "materialized": {
      "type": "boolean"
    },
    "purged": {
      "type": "boolean"
    },
    "servicesRemoved": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "app",
    "materialized",
    "purged",
    "dist",
    "servicesRemoved"
  ],
  "type": "object"
}
