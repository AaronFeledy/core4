{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "detached": {
      "type": "boolean"
    },
    "handle": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "user",
                "global",
                "scratch"
              ],
              "type": "string"
            },
            "root": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "root"
          ],
          "type": "object"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "app"
      ],
      "type": "object"
    },
    "rendered": {
      "type": "boolean"
    }
  },
  "required": [
    "handle",
    "detached"
  ],
  "type": "object"
}
