{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "entry": {
      "type": "string"
    },
    "pluginName": {
      "type": "string"
    },
    "pluginsRoot": {
      "type": "string"
    },
    "pluginVersion": {
      "type": "string"
    },
    "trusted": {
      "type": "boolean"
    },
    "trustName": {
      "type": "string"
    },
    "trustSource": {
      "enum": [
        "flag",
        "persistent",
        "prompt",
        "session",
        "untrusted"
      ],
      "type": "string"
    }
  },
  "required": [
    "pluginName",
    "pluginVersion",
    "trustName",
    "pluginsRoot",
    "entry",
    "trusted",
    "trustSource"
  ],
  "type": "object"
}
