{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "items": {
    "additionalProperties": false,
    "properties": {
      "app": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "user",
              "global",
              "scratch"
            ],
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "root"
        ],
        "type": "object"
      },
      "created": {
        "type": "string"
      },
      "id": {
        "type": "string"
      },
      "mode": {
        "enum": [
          "full",
          "baked",
          "cwd"
        ],
        "type": "string"
      },
      "source": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "fork"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "recipe"
                ],
                "type": "string"
              },
              "ref": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "type": "object"
          }
        ]
      },
      "status": {
        "enum": [
          "attached",
          "detached",
          "orphan"
        ],
        "type": "string"
      }
    },
    "required": [
      "id",
      "app",
      "source",
      "mode",
      "created",
      "status"
    ],
    "type": "object"
  },
  "type": "array"
}
