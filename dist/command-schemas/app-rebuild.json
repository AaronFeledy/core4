{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "string"
    },
    "servicesRebuilt": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "servicesStarted": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endpoints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "endpoints"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "app",
    "servicesRebuilt",
    "servicesStarted"
  ],
  "type": "object"
}
