{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "string"
    },
    "launch": {
      "enum": [
        "opened",
        "printed",
        "headless-degraded"
      ],
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hostname": {
            "type": "string"
          },
          "scheme": {
            "enum": [
              "http",
              "https"
            ],
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "hostname",
          "scheme",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "app",
    "targets",
    "launch"
  ],
  "type": "object"
}
