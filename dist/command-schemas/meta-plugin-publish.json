{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "number"
    },
    "packageContents": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pluginName": {
      "type": "string"
    },
    "pluginRoot": {
      "type": "string"
    },
    "published": {
      "type": "boolean"
    },
    "rebuilt": {
      "type": "boolean"
    },
    "registry": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "tested": {
      "type": "boolean"
    }
  },
  "required": [
    "pluginName",
    "pluginRoot",
    "registry",
    "tag",
    "packageContents",
    "dryRun",
    "rebuilt",
    "tested",
    "published",
    "exitCode"
  ],
  "type": "object"
}
