{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "checkMode": {
      "type": "boolean"
    },
    "drift": {
      "type": "boolean"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "checksum": {
            "type": "string"
          },
          "resolved": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "added",
              "updated",
              "unchanged"
            ],
            "type": "string"
          }
        },
        "required": [
          "source",
          "resolved",
          "checksum",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "lockfilePath": {
      "type": "string"
    },
    "noNetwork": {
      "type": "boolean"
    },
    "removed": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requestedSources": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "wrote": {
      "type": "boolean"
    }
  },
  "required": [
    "lockfilePath",
    "entries",
    "removed",
    "drift",
    "wrote",
    "checkMode",
    "noNetwork",
    "requestedSources"
  ],
  "type": "object"
}
