{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cspace": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "template": {
      "enum": [
        "service-type",
        "provider",
        "tooling-engine",
        "template-engine",
        "route-filter",
        "config-translator",
        "recipe",
        "bare"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "destination",
    "template",
    "cspace",
    "files"
  ],
  "type": "object"
}
