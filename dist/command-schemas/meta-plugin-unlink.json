{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "restored",
        "removed"
      ],
      "type": "string"
    },
    "pluginName": {
      "type": "string"
    },
    "registryEntry": {
      "type": "string"
    },
    "restoredPath": {
      "type": "string"
    }
  },
  "required": [
    "pluginName",
    "registryEntry",
    "action"
  ],
  "type": "object"
}
