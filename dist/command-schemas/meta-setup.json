{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "fileSyncStatus": {
      "enum": [
        "deferred",
        "installed",
        "satisfied",
        "unavailable"
      ],
      "type": "string"
    },
    "injectedCaCount": {
      "description": "Number of configured host CAs injected into type: lando services; 0 when no host CAs are configured or injection is disabled.",
      "type": "number"
    },
    "installDir": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    }
  },
  "required": [
    "providerId",
    "installDir",
    "fileSyncStatus",
    "injectedCaCount"
  ],
  "type": "object"
}
