{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "fileSyncStatus": {
      "enum": [
        "deferred",
        "installed",
        "satisfied",
        "unavailable"
      ],
      "type": "string"
    },
    "installDir": {
      "type": "string"
    },
    "providerId": {
      "type": "string"
    }
  },
  "required": [
    "providerId",
    "installDir",
    "fileSyncStatus"
  ],
  "type": "object"
}
