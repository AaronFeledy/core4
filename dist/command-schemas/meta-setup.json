{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "fileSyncStatus": {
      "enum": [
        "deferred",
        "installed",
        "satisfied",
        "unavailable"
      ],
      "type": "string"
    },
    "installDir": {
      "type": "string"
    },
    "notes": {
      "description": "Informational setup notes, such as host CA material that injects into services.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "providerId": {
      "type": "string"
    }
  },
  "required": [
    "providerId",
    "installDir",
    "fileSyncStatus",
    "notes"
  ],
  "type": "object"
}
