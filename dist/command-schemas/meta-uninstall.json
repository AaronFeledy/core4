{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "failed": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "keep-data",
        "purge"
      ],
      "type": "string"
    },
    "refused": {
      "type": "boolean"
    },
    "reportPath": {
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "destructive": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "completed",
              "failed",
              "manual",
              "skipped"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "owned",
              "user-owned",
              "skipped",
              "manual"
            ],
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "target",
          "destructive",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "dryRun",
    "refused",
    "mode",
    "failed",
    "steps"
  ],
  "type": "object"
}
