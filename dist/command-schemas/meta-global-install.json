{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "dist": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "serviceIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "created",
            "updated",
            "unchanged"
          ],
          "type": "string"
        }
      },
      "required": [
        "path",
        "status",
        "serviceIds"
      ],
      "type": "object"
    },
    "paths": {
      "additionalProperties": false,
      "properties": {
        "distLandofile": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "userLandofile": {
          "type": "string"
        }
      },
      "required": [
        "root",
        "distLandofile",
        "userLandofile"
      ],
      "type": "object"
    },
    "userLandofileCreated": {
      "type": "boolean"
    }
  },
  "required": [
    "paths",
    "dist",
    "userLandofileCreated"
  ],
  "type": "object"
}
