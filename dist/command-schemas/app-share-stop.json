{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "starting",
        "ready",
        "stopped",
        "failed",
        "unknown"
      ],
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "status"
  ],
  "type": "object"
}
