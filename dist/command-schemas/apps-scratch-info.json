{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "user",
            "global",
            "scratch"
          ],
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "root"
      ],
      "type": "object"
    },
    "created": {
      "type": "string"
    },
    "endpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endpoints": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "number"
                },
                "protocol": {
                  "type": "string"
                }
              },
              "required": [
                "protocol"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "endpoints"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "full",
        "baked",
        "cwd"
      ],
      "type": "string"
    },
    "mounts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "app",
              "bind",
              "tmpfs",
              "volume"
            ],
            "type": "string"
          },
          "readOnly": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "target",
          "kind",
          "readOnly"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "perAppBridge": {
          "type": "string"
        },
        "sharedNetwork": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "source": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "fork"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "recipe"
              ],
              "type": "string"
            },
            "ref": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "type": "object"
        }
      ]
    },
    "status": {
      "enum": [
        "attached",
        "detached",
        "orphan"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "app",
    "source",
    "mode",
    "created",
    "status",
    "mounts",
    "network",
    "endpoints"
  ],
  "type": "object"
}
