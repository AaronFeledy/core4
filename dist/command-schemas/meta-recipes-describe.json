{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "postInit": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "prompts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "source": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "version",
    "source",
    "tags",
    "prompts",
    "files",
    "postInit"
  ],
  "type": "object"
}
