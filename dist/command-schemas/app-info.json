{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agentEnv": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "forwarded": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "forwarded"
      ],
      "type": "object"
    },
    "app": {
      "type": "string"
    },
    "hostProxy": {
      "additionalProperties": false,
      "properties": {
        "runLando": {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "enum": [
                "available",
                "unavailable"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "availability"
          ],
          "type": "object"
        }
      },
      "required": [
        "runLando"
      ],
      "type": "object"
    },
    "services": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "api": {
            "enum": [
              4
            ],
            "type": "number"
          },
          "app": {
            "type": "string"
          },
          "endpoints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "logSources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "availability": {
                  "enum": [
                    "available",
                    "redirected-to-console",
                    "unavailable"
                  ],
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "strategy": {
                  "enum": [
                    "redirect",
                    "follow"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "path",
                "strategy",
                "availability"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "primary": {
            "type": "boolean"
          },
          "provider": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "stopped",
              "starting",
              "running",
              "healthy",
              "unhealthy",
              "error"
            ],
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "app",
          "service",
          "api",
          "type",
          "provider",
          "primary",
          "status",
          "endpoints"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "app",
    "services"
  ],
  "type": "object"
}
