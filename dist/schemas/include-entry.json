{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "string"
    },
    {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "type": "string"
        },
        "kind": {
          "description": "The fragment content semantics: \"landofile\" is a Landofile fragment; \"compose\" is a Compose fragment routed through the same parser, rejection, and decode path. This is not source transport.",
          "enum": [
            "landofile",
            "compose"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    }
  ]
}
