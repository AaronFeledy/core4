{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "_tag": {
          "description": "File-reference discriminator.",
          "enum": [
            "FileRef"
          ],
          "type": "string"
        },
        "checksum": {
          "description": "Lowercase hexadecimal SHA-256 of the file bytes.",
          "type": "string"
        },
        "encoding": {
          "description": "Detected file encoding.",
          "enum": [
            "utf-8",
            "binary",
            "ascii"
          ],
          "type": "string"
        },
        "mime": {
          "description": "MIME type inferred from the file extension.",
          "type": "string"
        },
        "path": {
          "description": "Resolved absolute path after symlink resolution.",
          "type": "string"
        },
        "size": {
          "description": "a non-negative number",
          "minimum": 0,
          "title": "nonNegative",
          "type": "integer"
        }
      },
      "required": [
        "_tag",
        "path",
        "size",
        "mime",
        "checksum",
        "encoding"
      ],
      "title": "File Reference",
      "type": "object"
    }
  },
  "$ref": "#/$defs/FileRef",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
