{
  "name": "@lando/engine",
  "description": "Private runtime engine implementation for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "engine"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./operations/uninstall": "./src/operations/uninstall.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "engine", "runtime"],
  "dependencies": {
    "@lando/container-runtime": "workspace:*",
    "@lando/http-client": "workspace:*",
    "@lando/landofile": "workspace:*",
    "@lando/paths": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*",
    "effect": "^3.21.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
