{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "composite": true,
    "noEmit": false,
    "paths": {
      "@lando/container-runtime": ["../container-runtime/src/index.ts"],
      "@lando/container-runtime/*": ["../container-runtime/src/*.ts"],
      "@lando/landofile": ["../landofile/src/index.ts"],
      "@lando/landofile/*": ["../landofile/src/*.ts"],
      "@lando/paths": ["../paths/src/paths.ts"],
      "@lando/paths/*": ["../paths/src/*.ts"],
      "@lando/sdk": ["../sdk/src/index.ts"],
      "@lando/sdk/*": ["../sdk/src/*/index.ts"],
      "@lando/state-store": ["../state-store/src/index.ts"],
      "@lando/state-store/*": ["../state-store/src/*.ts"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./dist", "./node_modules"],
  "references": [
    { "path": "../sdk" },
    { "path": "../paths" },
    { "path": "../state-store" },
    { "path": "../container-runtime" },
    { "path": "../landofile" }
  ]
}
