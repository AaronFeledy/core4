{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "composite": true,
    "noEmit": false
  },
  "include": ["./src/**/*.ts", "./package.json"],
  "exclude": ["./dist", "./node_modules"],
  "references": [
    {
      "path": "../sdk"
    },
    {
      "path": "../paths"
    },
    {
      "path": "../state-store"
    },
    {
      "path": "../container-runtime"
    },
    {
      "path": "../landofile"
    },
    {
      "path": "../redaction"
    },
    {
      "path": "../http-client"
    }
  ]
}
