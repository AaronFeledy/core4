{
  "name": "@lando/service-lando",
  "description": "The opinionated `lando` service base \u2014 boot scaffolding, env layer, packages, app mounts, healthchecks, certs, SSH agent, and run hooks.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "plugins/service-lando"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./php-internals": "./src/php-internals.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo", "./plugin.yaml", "./README.md"],
  "keywords": ["lando", "lando-plugin"],
  "lando": {
    "manifest": "./plugin.yaml"
  },
  "peerDependencies": {
    "@lando/sdk": "workspace:*"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@lando/core": "workspace:*",
    "@lando/provider-docker": "workspace:*",
    "@lando/provider-lando": "workspace:*"
  }
}
