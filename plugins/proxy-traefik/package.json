{
  "name": "@lando/proxy-traefik",
  "description": "Traefik-backed `RouterService` implementation contributing `routerServices`.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/AaronFeledy/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFeledy/core4.git",
    "directory": "plugins/proxy-traefik"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo", "./plugin.yaml"],
  "keywords": ["lando", "lando-plugin", "lando-proxy", "traefik"],
  "lando": {
    "manifest": "./plugin.yaml"
  },
  "dependencies": {
    "@lando/container-runtime": "workspace:*",
    "@lando/http-client": "workspace:*",
    "@lando/paths": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*",
    "effect": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b"
  }
}
