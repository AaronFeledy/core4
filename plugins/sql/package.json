{
  "name": "@lando/sql",
  "description": "Bundled database import, export, snapshot, restore, and reset commands.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "plugins/sql"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo", "./plugin.yaml"],
  "keywords": ["lando", "lando-plugin", "database", "sql"],
  "lando": {
    "manifest": "./plugin.yaml"
  },
  "dependencies": {
    "@lando/container-runtime": "workspace:*",
    "@lando/sdk": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@lando/data-mover": "workspace:*",
    "@lando/paths": "workspace:*",
    "@lando/state-store": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b"
  }
}
