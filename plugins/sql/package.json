{
  "name": "@lando/sql",
  "description": "Bundled database import, export, snapshot, restore, and reset commands.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/AaronFeledy/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFeledy/core4.git",
    "directory": "plugins/sql"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo", "./plugin.yaml"],
  "keywords": ["lando", "lando-plugin", "database", "sql"],
  "lando": {
    "manifest": "./plugin.yaml"
  },
  "landoPlugin": {
    "name": "@lando/sql",
    "version": "0.0.0",
    "api": 4,
    "requires": { "@lando/core": "^4.0.0" },
    "description": "Bundled database import, export, snapshot, restore, and reset commands.",
    "enabled": true,
    "entry": "./src/index.ts",
    "contributes": {
      "commands": [
        { "id": "db:import", "summary": "Import a database dump into a service." },
        { "id": "db:export", "summary": "Export a database dump from a service." },
        { "id": "db:snapshot", "summary": "Create a named snapshot of a database service." },
        {
          "id": "db:snapshots",
          "summary": "List database snapshots and recovery points.",
          "mcpAllowed": true
        },
        { "id": "db:snapshots:prune", "summary": "Preview or apply database snapshot retention." },
        { "id": "db:restore", "summary": "Restore a database service from a snapshot." },
        { "id": "db:reset", "summary": "Reset a database service to an empty state." },
        { "id": "db:seed", "summary": "Seed a fresh database from a dump, snapshot, or running app." }
      ]
    }
  },
  "dependencies": {
    "@lando/container-runtime": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@lando/data-mover": "workspace:*",
    "@lando/paths": "workspace:*",
    "@lando/state-store": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b"
  },
  "exports": {
    ".": "./src/index.ts",
    "./compression": "./src/compression.ts"
  }
}
