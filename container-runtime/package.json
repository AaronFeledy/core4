{
  "name": "@lando/container-runtime",
  "description": "Private provider-agnostic container runtime helpers for Lando providers.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "container-runtime"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport.ts",
    "./streams": "./src/streams.ts",
    "./plan": "./src/plan.ts",
    "./image-build": "./src/image-build.ts",
    "./log-file-access": "./src/log-file-access.ts",
    "./log-file-helper-payloads": "./src/log-file-helper-payloads.ts",
    "./data-plane": "./src/data-plane.ts",
    "./capabilities": "./src/capabilities.ts",
    "./dependency-gates": "./src/dependency-gates.ts",
    "./dependency-schedule": "./src/dependency-schedule.ts",
    "./service-start-schedule": "./src/service-start-schedule.ts",
    "./engine-api": "./src/engine-api.ts",
    "./redact": "./src/redact.ts",
    "./engine-errors": "./src/engine-errors.ts",
    "./dialect": "./src/dialect.ts",
    "./runtime-provider": "./src/runtime-provider.ts",
    "./image-pull": "./src/image-pull.ts",
    "./service-lifecycle": "./src/service-lifecycle.ts",
    "./wait-for-exit": "./src/wait-for-exit.ts",
    "./podman/api-client": "./src/podman/api-client.ts",
    "./podman/bring-up": "./src/podman/bring-up.ts",
    "./podman/bring-down": "./src/podman/bring-down.ts",
    "./podman/compose": "./src/podman/compose.ts",
    "./podman/compose-knobs": "./src/podman/compose-knobs.ts",
    "./podman/volume-prune": "./src/podman/volume-prune.ts",
    "./podman/inspect": "./src/podman/inspect.ts",
    "./podman/exec": "./src/podman/exec.ts",
    "./podman/logs": "./src/podman/logs.ts",
    "./podman/container-events": "./src/podman/container-events.ts",
    "./podman/health": "./src/podman/health.ts",
    "./podman/version-floor": "./src/podman/version-floor.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "container-runtime", "provider"],
  "dependencies": {
    "@lando/sdk": "workspace:*",
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b && bun run build:log-file-helper",
    "build:log-file-helper": "bun build ./src/log-file-helper-bin.ts --compile --target=bun-linux-x64 --outfile ./dist/log-file-access/linux-x64/lando-log-file-helper && bun build ./src/log-file-helper-bin.ts --compile --target=bun-linux-arm64 --outfile ./dist/log-file-access/linux-arm64/lando-log-file-helper",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
