{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "rootDir": ".."
  },
  "include": ["./**/*.ts", "../core/build.config.ts"],
  "exclude": ["./**/*.test.ts", "./generated/**"]
}
