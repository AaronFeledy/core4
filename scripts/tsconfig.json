{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "composite": false,
    "rootDir": ".."
  },
  "include": [
    "./check-*.ts",
    "./linux-runtime-bundle-builder.ts",
    "./runtime-bundle-builder/entry.ts",
    "./module-edge-scan.ts",
    "./boundary/**/*.ts",
    "./build-workflow-performance-workflow.ts",
    "./workflow-performance.ts",
    "./workflow-performance-*.ts"
  ],
  "exclude": ["./check-public-transcripts.ts", "./check-compose-coverage.ts"]
}
