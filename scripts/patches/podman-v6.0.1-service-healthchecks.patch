+++ b/libpod/healthcheck_service_test.go
@@ -0,0 +1,56 @@
+//go:build !remote && (linux || freebsd)
+
+package libpod
+
+import (
+	"context"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"go.podman.io/podman/v6/pkg/hcschedule"
+)
+
+func TestScheduledHealthCheckIsFencedToItsRun(t *testing.T) {
+	started := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	ctr := &Container{state: &ContainerState{StartedTime: started}}
+
+	assert.True(t, ctr.healthCheckRunCurrentLocked(context.Background()), "a manual check is never fenced")
+	sameRun := context.WithValue(context.Background(), healthCheckRunKey{}, started)
+	assert.True(t, ctr.healthCheckRunCurrentLocked(sameRun))
+	olderRun := context.WithValue(context.Background(), healthCheckRunKey{}, started.Add(-time.Minute))
+	assert.False(t, ctr.healthCheckRunCurrentLocked(olderRun), "a check of an older run must not write results")
+}
+
+func TestManualHealthCheckWaitsForTheScheduledCheck(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		s := hcschedule.New(nil, t.Logf)
+		serviceHealthChecks.Store(s)
+		t.Cleanup(func() { serviceHealthChecks.Store(nil) })
+		scheduled := context.WithValue(context.Background(), healthCheckRunKey{}, time.Time{})
+
+		releaseScheduled := s.Guard("ctr")
+		serviceHealthCheckGuard(scheduled, "ctr")() // the scheduler already holds the guard
+		acquired := make(chan struct{})
+		go func() {
+			release := serviceHealthCheckGuard(context.Background(), "ctr")
+			close(acquired)
+			release()
+		}()
+
+		synctest.Wait()
+		select {
+		case <-acquired:
+			t.Fatal("a manual check ran while a scheduled check held the guard")
+		default:
+		}
+		releaseScheduled()
+		synctest.Wait()
+		select {
+		case <-acquired:
+		default:
+			t.Fatal("a manual check never acquired the released guard")
+		}
+	})
+}
