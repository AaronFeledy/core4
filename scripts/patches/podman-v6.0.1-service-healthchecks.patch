diff --git a/libpod/healthcheck_service.go b/libpod/healthcheck_service.go
new file mode 100644
index 0000000..a202a02
--- /dev/null
+++ b/libpod/healthcheck_service.go
@@ -0,0 +1,286 @@
+//go:build !remote && (linux || freebsd)
+
+package libpod
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sirupsen/logrus"
+	"go.podman.io/podman/v6/libpod/define"
+	"go.podman.io/podman/v6/libpod/events"
+	"go.podman.io/podman/v6/libpod/shutdown"
+	"go.podman.io/podman/v6/pkg/hcschedule"
+	"go.podman.io/storage/pkg/ioutils"
+)
+
+const (
+	// ServiceHealthChecksEnv opts `podman system service` into scheduling
+	// container healthchecks itself. Only the value "1" enables it, and only
+	// the API service reads it.
+	ServiceHealthChecksEnv = "PODMAN_SERVICE_HEALTHCHECKS"
+
+	// HealthCheckSchedulerAckFile is created in the run root once the
+	// service schedules healthchecks. It holds the service's decimal PID and
+	// a newline, and is removed when scheduling stops.
+	HealthCheckSchedulerAckFile = "healthcheck-scheduler.pid"
+
+	healthCheckShutdownHandler   = "healthcheck-scheduler"
+	healthCheckReconcileInterval = 30 * time.Second
+	healthCheckResubscribeDelay  = time.Second
+	healthCheckShutdownBound     = 5 * time.Second
+)
+
+// errHealthCheckStaleRun reports a check whose container restarted while it ran.
+var errHealthCheckStaleRun = errors.New("container restarted during the healthcheck; result discarded")
+
+// serviceHealthChecks is the scheduler of this process, if it runs one.
+var serviceHealthChecks atomic.Pointer[hcschedule.Scheduler]
+
+type healthCheckRunKey struct{}
+
+// healthCheckLifecycleEvents are the container events that can change
+// whether or how a container is checked. health_status is excluded: the
+// scheduler's own checks write it.
+var healthCheckLifecycleEvents = []events.Status{
+	events.Init, events.Start, events.Restart, events.Exited, events.Stop,
+	events.Pause, events.Unpause, events.Remove, events.Update, events.Cleanup,
+	events.Restore,
+}
+
+// ServeHealthChecks schedules the healthchecks of every running container
+// from this API service until the returned function is called, when the
+// service's environment opts in with ServiceHealthChecksEnv=1. Otherwise, or
+// when scheduling cannot start, it logs why and returns a no-op. Only one
+// opted-in service per storage is supported: a second one would check every
+// container again.
+func (r *Runtime) ServeHealthChecks() (stop func()) {
+	if os.Getenv(ServiceHealthChecksEnv) != "1" {
+		return func() {}
+	}
+	stop, err := r.startHealthCheckScheduler()
+	if err != nil {
+		logrus.Warnf("Not scheduling healthchecks: %v", err)
+		return func() {}
+	}
+	logrus.Infof("Scheduling container healthchecks in the API service")
+	return stop
+}
+
+func (r *Runtime) startHealthCheckScheduler() (func(), error) {
+	if !systemdHealthCheckTimersDisabled() {
+		return nil, errors.New("systemd healthcheck timers are enabled for this process; set DISABLE_HC_SYSTEMD=true")
+	}
+	s := hcschedule.New(healthCheckSource{r: r}, logrus.Debugf)
+	if !serviceHealthChecks.CompareAndSwap(nil, s) {
+		return nil, errors.New("healthcheck scheduler already running")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	// Events from the moment before the first sweep are replayed, so no
+	// lifecycle change falls between the sweep and the subscription.
+	since := time.Now()
+	dispatched := make(chan struct{})
+	go func() {
+		defer close(dispatched)
+		s.Run(ctx, healthCheckReconcileInterval)
+	}()
+	go r.followHealthCheckLifecycle(ctx, s, since)
+	<-s.Ready()
+
+	ack := filepath.Join(r.storageConfig.RunRoot, HealthCheckSchedulerAckFile)
+	pid := strconv.Itoa(os.Getpid())
+	var once sync.Once
+	stop := func() {
+		once.Do(func() {
+			if b, err := os.ReadFile(ack); err == nil && strings.TrimSpace(string(b)) == pid {
+				if err := os.Remove(ack); err != nil {
+					logrus.Warnf("Removing healthcheck scheduler acknowledgement: %v", err)
+				}
+			}
+			cancel()
+			<-dispatched
+			// healthCheckExec takes no context: a check still running after
+			// the bound is ended by its own healthcheck timeout.
+			if !s.Wait(healthCheckShutdownBound) {
+				logrus.Warnf("Healthchecks still running after %v at shutdown", healthCheckShutdownBound)
+			}
+			serviceHealthChecks.Store(nil)
+		})
+	}
+	// A signal exits from its shutdown handlers without running defers, so
+	// the handler must exist before the acknowledgement does.
+	if err := shutdown.Register(healthCheckShutdownHandler, func(_ os.Signal) error {
+		stop()
+		return nil
+	}); err != nil {
+		stop()
+		return nil, fmt.Errorf("registering healthcheck scheduler shutdown: %w", err)
+	}
+	if err := ioutils.AtomicWriteFile(ack, []byte(pid+"\n"), 0o644); err != nil {
+		if err := shutdown.Unregister(healthCheckShutdownHandler); err != nil {
+			logrus.Debugf("Unregistering healthcheck scheduler shutdown: %v", err)
+		}
+		stop()
+		return nil, fmt.Errorf("writing healthcheck scheduler acknowledgement: %w", err)
+	}
+	return stop, nil
+}
+
+// followHealthCheckLifecycle turns lifecycle events into scheduler hints.
+// Events are only hints; when the stream ends, every container is reconciled
+// and the stream resubscribed from the moment before.
+func (r *Runtime) followHealthCheckLifecycle(ctx context.Context, s *hcschedule.Scheduler, since time.Time) {
+	filters := []string{"type=" + events.Container.String()}
+	for _, status := range healthCheckLifecycleEvents {
+		filters = append(filters, "event="+status.String())
+	}
+	for {
+		results := make(chan events.ReadResult)
+		err := r.Events(ctx, events.ReadOptions{
+			EventChannel: results,
+			Filters:      filters,
+			FromStart:    true,
+			Since:        since.Format(time.RFC3339Nano),
+			Stream:       true,
+		})
+		delay, ended := healthCheckResubscribeDelay, true
+		if err != nil {
+			// Nothing was read: keep since and leave catching up to the
+			// scheduler's own periodic reconcile.
+			logrus.Debugf("Healthcheck scheduler cannot read events, relying on reconciliation: %v", err)
+			delay, ended = healthCheckReconcileInterval, false
+		} else {
+			for res := range results {
+				if res.Error != nil {
+					logrus.Debugf("Healthcheck scheduler event: %v", res.Error)
+					continue
+				}
+				s.Hint(res.Event.ID)
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(delay):
+		}
+		if ended {
+			since = time.Now()
+			s.ReconcileAll()
+		}
+	}
+}
+
+type healthCheckSource struct {
+	r *Runtime
+}
+
+func (h healthCheckSource) Observe(id string) (hcschedule.Observation, error) {
+	c, err := h.r.LookupContainer(id)
+	if errors.Is(err, define.ErrNoSuchCtr) {
+		return hcschedule.Observation{}, nil
+	}
+	if err != nil {
+		return hcschedule.Observation{}, err
+	}
+	return c.healthCheckObservation()
+}
+
+func (h healthCheckSource) ActiveIDs() ([]string, error) {
+	ctrs, err := h.r.GetRunningContainers()
+	if err != nil {
+		return nil, err
+	}
+	ids := make([]string, 0, len(ctrs))
+	for _, c := range ctrs {
+		if c.HasHealthCheck() {
+			ids = append(ids, c.ID())
+		}
+	}
+	return ids, nil
+}
+
+func (h healthCheckSource) Check(ctx context.Context, id string, run hcschedule.Run) error {
+	_, err := h.r.HealthCheck(context.WithValue(ctx, healthCheckRunKey{}, run.StartedAt), id)
+	return err
+}
+
+func (c *Container) healthCheckObservation() (hcschedule.Observation, error) {
+	if !c.HasHealthCheck() {
+		return hcschedule.Observation{}, nil
+	}
+	c.lock.Lock()
+	defer c.lock.Unlock()
+	if err := c.syncContainer(); err != nil {
+		if errors.Is(err, define.ErrNoSuchCtr) || errors.Is(err, define.ErrCtrRemoved) {
+			return hcschedule.Observation{}, nil
+		}
+		return hcschedule.Observation{}, err
+	}
+	if c.state.State != define.ContainerStateRunning {
+		return hcschedule.Observation{}, nil
+	}
+	results, err := c.readHealthCheckLog()
+	if err != nil {
+		return hcschedule.Observation{}, err
+	}
+	hc := c.HealthCheckConfig()
+	cadence := hcschedule.Cadence{Interval: hc.Interval, StartPeriod: hc.StartPeriod, StartInterval: hc.StartInterval}
+	if c.config.StartupHealthCheckConfig != nil {
+		cadence.StartupInterval = c.config.StartupHealthCheckConfig.Interval
+	}
+	return hcschedule.Observation{
+		Run:            hcschedule.Run{StartedAt: c.state.StartedTime, Cadence: cadence},
+		Active:         true,
+		StartupPending: c.config.StartupHealthCheckConfig != nil && !c.state.StartupHCPassed,
+		Starting:       results.Status == define.HealthCheckStarting,
+	}, nil
+}
+
+// scheduledHealthCheckRun returns the run a scheduled check is fenced to.
+func scheduledHealthCheckRun(ctx context.Context) (time.Time, bool) {
+	started, ok := ctx.Value(healthCheckRunKey{}).(time.Time)
+	return started, ok
+}
+
+// healthCheckRunCurrentLocked reports whether a scheduled check still belongs
+// to the container's current run. Unscheduled checks always do.
+// The caller must lock and sync the container.
+func (c *Container) healthCheckRunCurrentLocked(ctx context.Context) bool {
+	started, scheduled := scheduledHealthCheckRun(ctx)
+	return !scheduled || c.state.StartedTime.Equal(started)
+}
+
+// healthCheckRunCurrent is healthCheckRunCurrentLocked for callers that do not
+// hold the container lock.
+func (c *Container) healthCheckRunCurrent(ctx context.Context) bool {
+	started, scheduled := scheduledHealthCheckRun(ctx)
+	if !scheduled {
+		return true
+	}
+	current, err := c.StartedTime()
+	return err == nil && current.Equal(started)
+}
+
+// serviceHealthCheckGuard makes a healthcheck that the scheduler did not start
+// wait for a scheduled check of the same container in this process.
+func serviceHealthCheckGuard(ctx context.Context, id string) func() {
+	s := serviceHealthChecks.Load()
+	if _, scheduled := scheduledHealthCheckRun(ctx); s == nil || scheduled {
+		return func() {}
+	}
+	return s.Guard(id)
+}
+
+// schedulesHealthChecks reports whether this process is an API service that
+// schedules healthchecks.
+func schedulesHealthChecks() bool {
+	return serviceHealthChecks.Load() != nil
+}
