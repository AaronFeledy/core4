diff --git a/pkg/specgen/generate/healthcheck_start_interval_test.go b/pkg/specgen/generate/healthcheck_start_interval_test.go
new file mode 100644
index 0000000..32ca4d2
--- /dev/null
+++ b/pkg/specgen/generate/healthcheck_start_interval_test.go
@@ -0,0 +1,37 @@
+//go:build !remote && (linux || freebsd)
+
+package generate
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.podman.io/image/v5/manifest"
+	"go.podman.io/podman/v6/pkg/specgen"
+)
+
+func TestApplyHealthCheckOverridesStartInterval(t *testing.T) {
+	image := func() *manifest.Schema2HealthConfig {
+		return &manifest.Schema2HealthConfig{
+			Test:          []string{"CMD-SHELL", "true"},
+			Interval:      30 * time.Second,
+			StartInterval: 5 * time.Second,
+		}
+	}
+
+	t.Run("override replaces the image start interval", func(t *testing.T) {
+		s := &specgen.SpecGenerator{}
+		s.HealthConfig = &manifest.Schema2HealthConfig{StartInterval: time.Second}
+		require.NoError(t, applyHealthCheckOverrides(s, image()))
+		assert.Equal(t, time.Second, s.HealthConfig.StartInterval)
+		assert.Equal(t, []string{"CMD-SHELL", "true"}, s.HealthConfig.Test)
+	})
+
+	t.Run("image start interval is inherited", func(t *testing.T) {
+		s := &specgen.SpecGenerator{}
+		require.NoError(t, applyHealthCheckOverrides(s, image()))
+		assert.Equal(t, 5*time.Second, s.HealthConfig.StartInterval)
+	})
+}
