{
  "name": "@lando/managed-file",
  "description": "Private managed-file ownership implementation for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "managed-file"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./marker": "./src/marker.ts",
    "./codecs": "./src/codecs.ts",
    "./testing": "./src/testing.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "managed-file"],
  "dependencies": {
    "@lando/paths": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*",
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
