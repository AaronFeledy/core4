{
  "name": "@lando/mcp",
  "description": "Private MCP catalog, transport, and retained-runtime dispatch implementation for Lando.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "mcp"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./allowlist": "./src/allowlist.ts",
    "./bounded-json": "./src/bounded-json.ts",
    "./cancellation": "./src/cancellation.ts",
    "./catalog": "./src/catalog.ts",
    "./dispatch": "./src/dispatch.ts",
    "./execute": "./src/execute.ts",
    "./generated-allowlist": "./src/generated/mcp-allowlist.ts",
    "./port": "./src/port.ts",
    "./registry": "./src/registry.ts",
    "./result-inspector": "./src/result-inspector.ts",
    "./service": "./src/service.ts",
    "./stdio-limits": "./src/stdio-limits.ts",
    "./stdio-transport": "./src/stdio-transport.ts",
    "./transport": "./src/transport.ts",
    "./package.json": "./package.json"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "mcp", "json-rpc"],
  "dependencies": {
    "@lando/engine": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
