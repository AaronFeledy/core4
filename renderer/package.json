{
  "name": "@lando/renderer",
  "description": "Private renderer runtime, terminal IO, and command-output implementation for Lando.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/AaronFeledy/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronFeledy/core4.git",
    "directory": "renderer"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./console-layout": "./src/console-layout.ts",
    "./io": "./src/io.ts",
    "./native-stdio": "./src/native-stdio.ts",
    "./output": "./src/output.ts",
    "./output-drain": "./src/output-drain.ts",
    "./palette": "./src/palette.ts",
    "./runtime": "./src/runtime.ts",
    "./stdio": "./src/stdio.ts",
    "./stdio-flags": "./src/stdio-flags.ts",
    "./summary": "./src/summary.ts",
    "./package.json": "./package.json"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "renderer", "terminal"],
  "dependencies": {
    "@lando/engine": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "effect": "catalog:"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
