---
import { isPlaceholderResultSummary } from "../lib/is-placeholder.ts";
import { componentFramePropsFor } from "./component-frame.ts";

interface Props {
  readonly file?: string;
  readonly json?: string;
  readonly events?: true;
  readonly output?: true;
  readonly [key: string]: unknown;
}

const { file, json, events } = Astro.props;
const [kind, target] =
  file !== undefined
    ? ["file", file]
    : json !== undefined
      ? ["JSON", json]
      : events === true
        ? ["events", "event stream"]
        : ["output", "command output"];
const { dataAttributes, resolution, frame } = await componentFramePropsFor(Astro.props, "inspect");
const showCapturedOutput = frame?.resultSummary && !isPlaceholderResultSummary(frame.resultSummary);
---

<figure class="lando-inspect" {...dataAttributes}>
  <figcaption>Inspect {kind}</figcaption>
  <pre><code>{target}</code></pre>
  {showCapturedOutput && <pre class="lando-frame-output"><code>{frame.resultSummary}</code></pre>}
  {frame && <a class="lando-frame__source" href={frame.sourceHref}>source</a>}
</figure>
