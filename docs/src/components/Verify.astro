---
import { isPlaceholderResultSummary } from "../lib/is-placeholder.ts";
import { componentFramePropsFor } from "./component-frame.ts";

interface Props {
  readonly event?: string;
  readonly command?: string;
  readonly file?: string;
  readonly errorTag?: string;
  readonly expect?: unknown;
  readonly [key: string]: unknown;
}

const { event, command, file, errorTag, expect } = Astro.props;
const [kind, target] = [
  ["event", event],
  ["command", command],
  ["file", file],
  ["error", errorTag],
].find((entry) => entry[1] !== undefined) ?? ["check", ""];
const expectation =
  expect === undefined ? undefined : typeof expect === "object" ? JSON.stringify(expect) : String(expect);
const { dataAttributes, resolution, frame } = await componentFramePropsFor(Astro.props, "verify");
const showCapturedOutput = frame?.resultSummary && !isPlaceholderResultSummary(frame.resultSummary);
---

<div class="lando-verify" {...dataAttributes}>
  <p>
    <strong>Verify {kind}:</strong>
    <code>{target}</code>
    {expectation && <span>expects <code>{expectation}</code></span>}
  </p>
  {frame?.commandDisplay && <pre><code class="language-sh">{frame.commandDisplay}</code></pre>}
  {showCapturedOutput && (
    <figure class="lando-frame-output">
      <figcaption>Captured output</figcaption>
      <pre><code>{frame.resultSummary}</code></pre>
    </figure>
  )}
  {frame && <a class="lando-frame__source" href={frame.sourceHref}>source</a>}
  {resolution.status === "missing" && <p class="lando-transcript-placeholder"><em>{resolution.label}</em></p>}
</div>
