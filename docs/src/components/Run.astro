---
import { isPlaceholderResultSummary } from "../lib/is-placeholder.ts";
import { componentFramePropsFor } from "./component-frame.ts";

interface Props {
  readonly command?: string;
  readonly shell?: string;
  readonly runtime?: "library";
  readonly code?: string;
  readonly displayCode?: string;
  readonly answers?: Readonly<Record<string, string>>;
  readonly expectExit?: number;
  readonly [key: string]: unknown;
}

const { command, shell, runtime, code, displayCode } = Astro.props;
const displayedCode = displayCode ?? command ?? shell ?? code ?? "";
const language = runtime === "library" ? "ts" : "sh";
const { dataAttributes, resolution, frame } = await componentFramePropsFor(Astro.props, "run");
const renderedCommand = frame?.commandDisplay ?? displayedCode;
const showCapturedOutput = frame?.resultSummary && !isPlaceholderResultSummary(frame.resultSummary);
---

<div
  class="lando-run"
  data-transcript-status={resolution.status}
  data-transcript-reason={resolution.status === "missing" ? resolution.reason : undefined}
  {...dataAttributes}
>
  <pre><code class={`language-${language}`}>{renderedCommand}</code></pre>
  {showCapturedOutput && (
    <figure class="lando-frame-output">
      <figcaption>Captured output</figcaption>
      <pre><code>{frame.resultSummary}</code></pre>
    </figure>
  )}
  {frame && <a class="lando-frame__source" href={frame.sourceHref}>source</a>}
  {resolution.status === "missing" && <p class="lando-transcript-placeholder"><em>{resolution.label}</em></p>}
</div>
