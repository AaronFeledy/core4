{
  "name": "@lando/core",
  "description": "Lando v4 core: runtime, planner, native CLI dispatcher, and library API.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": "lando-community/core4",
  "bugs": "https://github.com/lando-community/core4/issues",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "lando": "./bin/lando.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./bundled-plugins": {
      "types": "./src/runtime/bundled-plugins.ts",
      "import": "./src/runtime/bundled-plugins.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./secrets": {
      "types": "./src/secrets/index.ts",
      "import": "./src/secrets/index.ts"
    },
    "./docs/components": {
      "types": "./src/docs/components/index.ts",
      "import": "./src/docs/components/index.ts"
    },
    "./docs/render": {
      "types": "./src/docs/render/index.ts",
      "import": "./src/docs/render/index.ts"
    },
    "./docs/redactions": {
      "types": "./src/docs/render/redaction.ts",
      "import": "./src/docs/render/redaction.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts"
    },
    "./landofile": {
      "types": "./src/landofile/index.ts",
      "import": "./src/landofile/index.ts"
    },
    "./events": {
      "types": "./src/lifecycle/index.ts",
      "import": "./src/lifecycle/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts"
    },
    "./cli/operations": {
      "types": "./src/cli/operations.ts",
      "import": "./src/cli/operations.ts"
    },
    "./paths": {
      "types": "./src/config/paths.ts",
      "import": "./src/config/paths.ts"
    }
  },
  "files": ["./bin", "./dist", "!./dist/**/*.tsbuildinfo", "./src"],
  "keywords": ["lando", "lando-core", "effect", "bun"],
  "dependencies": {
    "@lando/container-runtime": "workspace:*",
    "@lando/engine": "workspace:*",
    "@lando/http-client": "workspace:*",
    "@lando/landofile": "workspace:*",
    "@lando/managed-file": "workspace:*",
    "@lando/paths": "workspace:*",
    "@lando/redaction": "workspace:*",
    "@lando/sdk": "workspace:*",
    "@lando/state-store": "workspace:*",
    "effect": "^3.21.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  },
  "scripts": {
    "build": "bun run build:manifest && bun run build:host-proxy-shim && bun run build:log-file-helper && bun run build:compile",
    "build:bin": "bun build ./bin/lando.ts --outdir ./dist --target bun",
    "build:host-proxy-shim": "bun build ./src/cli/host-proxy/shim-bin.ts --compile --target=bun-linux-x64 --outfile ./dist/host-proxy/linux-x64/lando-shim && bun build ./src/cli/host-proxy/shim-bin.ts --compile --target=bun-linux-arm64 --outfile ./dist/host-proxy/linux-arm64/lando-shim",
    "build:log-file-helper": "bun build ../container-runtime/src/log-file-helper-bin.ts --compile --target=bun-linux-x64 --outfile ./dist/log-file-access/linux-x64/lando-log-file-helper && bun build ../container-runtime/src/log-file-helper-bin.ts --compile --target=bun-linux-arm64 --outfile ./dist/log-file-access/linux-arm64/lando-log-file-helper",
    "build:manifest": "bun run ../scripts/build-command-registry-manifest.ts",
    "build:compile": "bun run ../scripts/build-compiled-binary.ts --outfile ./dist/lando --minify --sourcemap=external && bun run ../scripts/sanitize-compiled-binary.ts ./dist/lando",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test",
    "typecheck": "tsc -b",
    "prepack": "bun run build:manifest"
  }
}
