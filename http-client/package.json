{
  "name": "@lando/http-client",
  "description": "Private HTTP egress adapter (HttpClient, network trust, downloader) for Lando runtimes.",
  "version": "0.0.0",
  "author": "Lando Alliance",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lando-community/core4.git",
    "directory": "http-client"
  },
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service": "./src/service.ts",
    "./live": "./src/live.ts",
    "./network-trust": "./src/network-trust.ts",
    "./timeout": "./src/timeout.ts",
    "./downloader": "./src/downloader.ts"
  },
  "files": ["./src", "./dist", "!./dist/**/*.tsbuildinfo"],
  "keywords": ["lando", "http-client", "downloader"],
  "dependencies": {
    "@lando/sdk": "workspace:*",
    "effect": "^3.21.2"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test ./test",
    "typecheck": "tsc -b"
  }
}
