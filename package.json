{
  "name": "@lando/monorepo",
  "version": "0.0.0",
  "description": "Lando v4 monorepo: @lando/core, @lando/sdk, and bundled plugins.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lando-community/core4",
  "repository": "lando-community/core4",
  "bugs": "https://github.com/lando-community/core4/issues",
  "workspaces": ["core", "sdk", "container-runtime", "paths", "state-store", "landofile", "plugins/*"],
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.14",
    "mdast-util-to-markdown": "^2.1.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "bun run --filter='*' build",
    "test": "bun run scripts/test-shards.ts",
    "test:unit": "bun --no-orphans test --path-ignore-patterns='**/*.integration.test.ts'",
    "test:unit:shard": "bun run scripts/test-shards.ts --run",
    "test:changed": "bun test --changed",
    "bench:tooling-hot-path": "bun run scripts/bench-tooling-hot-path.ts",
    "bench:opentui-startup": "bun run scripts/bench-opentui-startup.ts",
    "typecheck": "tsc -b",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "biome check . && bun run check:deprecations",
    "format": "biome format --write .",
    "clean": "bun run --filter='*' clean && rm -rf dist .tsbuildinfo",
    "codegen": "bun run scripts/codegen.ts",
    "codegen:check": "bun run codegen && bun run check:codegen-drift && bun run check:deprecations && bun run typecheck",
    "codegen:guide-scenarios": "bun run scripts/build-guide-scenarios.ts",
    "docs:scenario": "bun run scripts/docs-scenario.ts",
    "dev:guides": "bun run scripts/dev-guides.ts",
    "lint:guides": "bun run scripts/lint-guides.ts",
    "check:core-layering-boundary": "bun run scripts/check-core-layering-boundary.ts",
    "check:renderer-boundary": "bun run scripts/check-renderer-boundary.ts",
    "check:spec-reference": "bun run scripts/check-spec-reference.ts",
    "check:managed-file-boundary": "bun run scripts/check-managed-file-boundary.ts",
    "check:redaction-boundary": "bun run scripts/check-redaction-boundary.ts",
    "check:env-helper-boundary": "bun run scripts/check-env-helper-boundary.ts",
    "check:generated-output": "bun run scripts/check-generated-output.ts",
    "check:codegen-drift": "bun run scripts/check-codegen-drift.ts",
    "check:package-dag": "bun run scripts/check-package-dag.ts",
    "check:paths-boundary": "bun run scripts/check-paths-boundary.ts",
    "check:state-store-boundary": "bun run scripts/check-state-store-boundary.ts",
    "check:probe-boundary": "bun run scripts/check-probe-boundary.ts",
    "check:network-boundary": "bun run scripts/check-network-boundary.ts",
    "check:libpod-prefix": "bun run scripts/check-libpod-prefix.ts",
    "check:machine-output": "bun run scripts/check-machine-output.ts",
    "check:runtime-bundle-manifest": "bun run scripts/check-runtime-bundle-manifest.ts",
    "check:telemetry-inventory": "bun run scripts/check-telemetry-inventory.ts",
    "check:deprecations": "bun run scripts/check-deprecations.ts",
    "check:import-cycle": "bun run scripts/check-import-cycle.ts",
    "check:guide-coverage": "bun run scripts/check-guide-coverage.ts",
    "check:public-transcripts": "bun run scripts/check-public-transcripts.ts",
    "check:guide-drift": "bun run scripts/check-guide-drift.ts",
    "check:compose-coverage": "bun run scripts/check-compose-coverage.ts",
    "check:schema-compatibility": "bun run scripts/check-schema-compatibility.ts",
    "codegen:bootstrap-layers": "bun run scripts/build-bootstrap-layers.ts",
    "codegen:bundled-plugins": "bun run scripts/build-bundled-plugins.ts",
    "codegen:setup-plugin-flags": "bun run scripts/build-setup-plugin-flags.ts",
    "codegen:mcp-allowlist": "bun run scripts/build-mcp-allowlist.ts",
    "codegen:host-proxy-allowlist": "bun run scripts/build-host-proxy-allowlist.ts",
    "codegen:command-registry-manifest": "bun run scripts/build-command-registry-manifest.ts",
    "codegen:command-reference": "bun run scripts/build-command-reference.ts",
    "codegen:compose-key-matrix": "bun run scripts/build-compose-key-matrix.ts",
    "codegen:recipe-readmes": "bun run scripts/build-recipe-readmes.ts",
    "codegen:bundled-recipes": "bun run scripts/build-bundled-recipes.ts",
    "codegen:schema-snapshot": "bun run scripts/build-schema-snapshot.ts",
    "codegen:mutagen-versions": "bun run scripts/build-mutagen-versions.ts",
    "codegen:provider-images": "bun run scripts/build-provider-images.ts",
    "codegen:compose-vendor": "bun run scripts/build-compose-vendor.ts",
    "codegen:compose-fixtures": "bun run scripts/build-compose-fixtures.ts",
    "codegen:compose-fixture-manifest": "bun run scripts/build-compose-fixture-manifest.ts",
    "codegen:opentui-native-stubs": "bun run scripts/build-opentui-native-stubs.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
