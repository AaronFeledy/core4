      "entry": "./src/index.ts",
      "name": "@lando/logger-pretty",
      "requires": {
        "@lando/core": "^4.0.0"
      },
      "version": "0.0.0"
    },
    "name": "@lando/logger-pretty"
  },
  {
    "manifest": {
      "api": 4,
      "bootstrap": "app",
      "description": "Bundled Lando desktop-notification policy plugin.",
      "enabled": true,
      "entry": "./src/index.ts",
      "name": "@lando/notify-lando",
      "requires": {
        "@lando/core": "^4.0.0"
      },
      "subscribers": [
        {
          "abortOnError": false,
          "configKey": "notify",
          "id": "notify-command-terminal",
          "module": "./src/notify.ts",
          "priority": 900,
          "selectors": [
            {
              "family": "cli-command-terminal"
            }
          ]
        }
      ],
      "version": "0.0.0"
    },
    "name": "@lando/notify-lando"
  },
  {
    "manifest": {
